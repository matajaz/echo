// Example secrets file. Copy to secrets.h and fill in real values.
// secrets.h is git-ignored -- never commit real credentials.
#pragma once

#define WIFI_SSID "your-ssid"
#define WIFI_PASS "your-password"
// Optional fallback (e.g. a phone hotspot) tried when the primary is
// unreachable. Leave WIFI_SSID_2 as "" to disable.
#define WIFI_SSID_2 ""
#define WIFI_PASS_2 ""

// OTA host serving firmware (nginx on debian.local:8091, same pattern as
// lumen/Vegena). URL prefix must match the allowlist check in ota.c.
#define OTA_URL_PREFIX "http://192.168.2.7:8091/echo/"
#define OTA_KEY "changeme"

// ---- Home Assistant (temperature page) ----
// LAN base URL (no trailing slash). Use the IP -- mDNS ha.local does not
// resolve on ESP32.
#define HA_BASE_URL "http://192.168.2.4:8123"
// Long-lived access token (HA: Profile -> Security -> Long-lived tokens).
#define HA_TOKEN "your-long-lived-token"
