CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
# Plain HTTP to our own LAN nginx (debian.local:8091), same trust model as
# lumen/Vegena -- no TLS cert to manage on a home LAN. The URL-prefix
# allowlist in ota.c (ota_url_allowed) is the actual SSRF/arbitrary-firmware
# guard; this flag only lifts esp_https_ota's blanket http-is-unverified gate.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# --- Networking: resource headroom for concurrent HTTP (OTA + HA poll) ----
# These reduce outbound-connection pressure. The connection-reuse change in
# ha_client.c (ONE kept-alive client per poll cycle) is the real improvement:
# it turns 4 connections/poll into 1, cutting churn regardless of the cause.
# These two settings are defense-in-depth headroom:
#   - shorter MSL => a closed TCP control block leaves TIME_WAIT in ~2*10s
#     instead of ~2*60s, freeing control blocks faster under bursts
#   - a few more socket descriptors for headroom (small RAM cost)
#
# UNVERIFIED (corrected 2026-10-10, Sol's review): an earlier note here claimed
# the PROVEN root cause of "ESP_ERR_HTTP_CONNECT" was TIME_WAIT socket-pool
# exhaustion. That is NOT established. The observed error 32774 = 0x8006 =
# ESP_ERR_ESP_TLS_CONNECTION_TIMEOUT (a connection-establishment TIMEOUT), NOT
# socket-allocation failure (which would be 0x8002). ESP_ERR_HTTP_CONNECT can
# wrap several underlying causes. The real failure stage still needs to be
# captured on hardware (errno, transport error, heap headroom, active conns)
# before any root cause is declared. Keep these settings — they don't hurt —
# but treat them as headroom, not a proven fix.
CONFIG_LWIP_TCP_MSL=10000
CONFIG_LWIP_MAX_SOCKETS=16

# --- OTA rollback: application-controlled confirmation --------------------
# Keep APP_ROLLBACK on, but DISABLE auto-confirm-on-startup so a freshly-OTA'd
# image stays ESP_OTA_IMG_PENDING_VERIFY into app_main. echo then confirms it
# (esp_ota_mark_app_valid_cancel_rollback) only AFTER the HTTP server — the
# only remote-recovery path — is up. Without this, the SDK's ota_auto_confirm
# startup hook marks the image VALID before app_main runs, so a post-startup
# wedge (WiFi/HTTP/peripheral) is NOT rolled back. (Found by Sol's review,
# 2026-10-10; corrects the earlier wrong assumption that the app_main confirm
# was already the gate.)
CONFIG_BOOTLOADER_APP_ROLLBACK_CONFIRM_BY_APP=y

# --- PSRAM: fix internal-heap starvation (proven root cause, 2026-10-10) -----
# /info showed heap_min dropping to 336 BYTES during OTA (LVGL+audio+sensors+
# WiFi+HTTP+TLS+8KB OTA task all on ~20KB internal heap) -> connect/TLS failed.
# The board HAS 8MB PSRAM (factory boot log: "Found 8MB PSRAM device, Speed
# 80MHz, Adding pool of 3328K ... to heap allocator") but it was disabled.
# Enable it quad @80MHz (matches factory) and let malloc + WiFi/LwIP use it,
# which moves the heavy buffers off internal RAM. First flash MUST be over USB.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Reserve more INTERNAL (DMA-capable) RAM when PSRAM is on. The 32 KB default
# was too small once PSRAM absorbed general malloc: I2S DMA buffer alloc
# (i2s_channel_init_std_mode) failed with ESP_ERR_NO_MEM (0x101), disabling
# audio, while aggregate heap looked huge (Sol's "DMA alloc can fail" warning,
# 2026-10-10). 128 KB covers I2S + SPI-LCD DMA + WiFi internal needs.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072

# --- LVGL fonts: enable smaller sizes so dense pages (device info, graph
#     readouts) can shrink text to fit instead of clipping. Montserrat 14
#     stays the default; 12/10 are used explicitly where space is tight. ---
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y

# Main task runs app_main: board/display/ui/sensors/ha/audio init + the
# readiness loop with logging. The 3584B IDF default overflowed (stack-
# protection panic in the main task after UI init) once the feature set grew.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Larger fonts for the Overview card design (big temp/power readings).
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# Theme title/reading fonts (echo_theme.h).
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y

# LVGL object pool: 32KB exhausted once every page builds its rows+cards
# (store fault in lv_obj_class_create_obj = failed lv_malloc). 64KB internal RAM.

# Use the ESP heap allocator (internal+PSRAM) for LVGL instead of a fixed
# static pool — the fixed pool capped object count (store faults on the
# card/list pages). PSRAM-backed, so object count is no longer the ceiling.

# LVGL allocates from PSRAM (shim) — fixed internal pool chronically ran
# full (lv_mem_buf_get hang under swipe+play). PSRAM frees internal RAM for WiFi.
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="lv_psram_alloc.h"
